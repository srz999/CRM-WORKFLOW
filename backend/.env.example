# Copy to backend/.env and fill in. Never commit the real .env.

# PostgreSQL (docker-compose.yml starts one with these credentials)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crm

# OpenAI - used by the extraction, classification, prioritization and resolution agents
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: only set for an OpenAI-compatible endpoint (e.g. a proxy). Leave blank for api.openai.com
OPENAI_BASE_URL=
LLM_TIMEOUT_SECONDS=30
# Set blank for models that do not accept a temperature parameter
LLM_TEMPERATURE=0

# Bounded retries per workflow stage (retryable failures only)
WORKFLOW_MAX_STAGE_ATTEMPTS=2
MAX_ISSUES_PER_CONVERSATION=10

# Optional n8n webhook (Production URL of the "CRM ticket created" webhook node). Blank = disabled.
N8N_WEBHOOK_URL=
N8N_TIMEOUT_SECONDS=2

# Frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
